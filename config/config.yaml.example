sqlite_path: "data/db.sqlite"
base_url: "https://xxx.vmedis.com"
concurrency: 10
refresh_interval: "1m"
rate_limit: 100

# The vmedis v2 report API, the one behind the "-v2" report pages. The values
# are in the gateway requests those pages send.
vmedis_v2:
  gateway_url: "https://apimwlap.vmedis.com/api/gateway"
  crypt_key: ""
  app_id: ""
  reg: ""

redis_address: "localhost:26379"
redis_password: ""
redis_db: 0
redis_sentinel_mode: true
redis_sentinel_master_name: myprimary

kafka_brokers:
    - "localhost:9092"

email:
  smtp_address: "smtp.example.com:567"
  smtp_username: ""
  smtp_password: ""
  from: ""
  iqvia:
    to: []
    cc: []

stock_opname_start_date: "2024-03-07"

consumer_concurrency: 10
# The pharmacy details printed on purchase orders (surat pesanan). Purchase
# orders are disabled (their endpoints respond with 503) while all of these
# are empty, and the server refuses to start when only some are set.
pharmacy_name: "" # e.g. "Apotek Aulia Farma"
pharmacy_license_number: ""
pharmacy_address: ""
pharmacy_email: ""
pharmacy_phone: ""
# Where letters are written from, printed before their date.
pharmacy_city: "" # e.g. "Sumedang"
# The pharmacist in charge (Apoteker Penanggung Jawab), without the "apt." title.
pharmacist_name: ""
# The pharmacist's SIPA.
pharmacist_license_number: ""
